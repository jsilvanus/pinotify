# Copy to .env (read from the working directory at startup) or point PINOTIFY_ENV_FILE at another file.
# Real environment variables override the file. Never commit the real file or any key, token or contact.

# Server
PINOTIFY_PORT=3109
PINOTIFY_HOST=0.0.0.0
# simulation: no real sends, messages are kept in memory (GET /api/v1/outbox). production: real providers.
PINOTIFY_MODE=simulation

# API tokens (Bearer). The admin token manages contacts and providers and can send.
# The send token can only send (give it to other pi* services such as pirundown).
# production requires PINOTIFY_ADMIN_TOKEN.
# PINOTIFY_ADMIN_TOKEN=
# PINOTIFY_SEND_TOKEN=

# Data at rest: contacts, provider settings and the attempt log are one JSON file, encrypted with AES-256-GCM.
# Key: 32 bytes as 64 hex characters or base64 (for example: openssl rand -hex 32). Required in production.
# Losing the key means losing the data; keep a copy outside the Pi.
# PINOTIFY_SECRET_KEY=
# PINOTIFY_DATA_DIR=./data

# Superuser contact, from the environment only (cannot be edited over the API). Other contacts are managed
# through the API/UI and stored encrypted. Setting an address here counts as that person's consent.
# PINOTIFY_SUPERUSER_NAME=
# PINOTIFY_SUPERUSER_EMAIL=
# PINOTIFY_SUPERUSER_SMS=+358...

# Limits per contact and channel (a backstop against message storms)
PINOTIFY_LIMIT_PER_HOUR=6
PINOTIFY_LIMIT_PER_DAY=20
PINOTIFY_COOLDOWN_MS=60000
PINOTIFY_LOG_DAYS=90
